# Database (Neon in prod; docker-compose locally)
DATABASE_URL=postgres://platform:platform@localhost:5432/platform

# Test database — REQUIRED to run integration tests. Integration tests read ONLY
# this variable; the production DATABASE_URL is ignored under test. If unset,
# integration tests skip (safe). The value must be a local Postgres or a DB whose
# name contains "test" and must NOT equal DATABASE_URL, or the run aborts.
# e.g. TEST_DATABASE_URL=postgres://platform:platform@localhost:5432/platform_test
TEST_DATABASE_URL=

# Redis (BullMQ + engine queue)
REDIS_URL=redis://localhost:6379

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Custom Clerk domain (PRODUCTION instances only). Must be allowed in the CSP or
# Clerk's script is blocked and auth buttons do nothing. Bare host, no scheme.
# Leave blank when using a Clerk development instance.
CLERK_FRONTEND_API_DOMAIN=clerk.ovanth.com

# Internal admin (Decision 011): comma-separated founder emails
FOUNDER_EMAILS=

# AI gateway
ANTHROPIC_API_KEY=
# Optional: embeddings for knowledge retrieval (skipped gracefully if unset)
VOYAGE_API_KEY=

# Observability (optional — no-op when unset)
# ── Error reporting (Sentry) ────────────────────────────────────────────────
# Server + worker ingest key. Set on BOTH Vercel and Railway. Empty = every
# captureException in the codebase is a silent no-op, which is the state this
# replaced.
SENTRY_DSN=
# Browser ingest key. Compiled into the client bundle, so it MUST be the
# NEXT_PUBLIC_ one. A DSN is write-only — it can send events, never read them.
# Vercel only. Same value as SENTRY_DSN unless you use a separate project.
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Overrides the auto-detected environment tag (VERCEL_ENV on Vercel,
# RAILWAY_ENVIRONMENT_NAME on Railway, NODE_ENV locally).
SENTRY_ENVIRONMENT=
# Optional, Vercel build-time only. Without these, source maps are not uploaded
# and production stack traces point at minified chunks. Nothing breaks.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Owner email notifications (Priority 2) — "a reply needs your approval".
# Uses Resend (https://resend.com). Both must be set or emails are skipped
# (drafts still wait in the dashboard). FROM must be a verified sender/domain.
RESEND_API_KEY=
# NOTE: this is a SENDING address and needs a verified domain in Resend.
# Cloudflare Email Routing (which handles inbound support@ovanth.com) forwards
# only — it cannot send, so it will not satisfy this.
NOTIFICATIONS_FROM_EMAIL="Ovanth <notifications@ovanth.com>"

# Gmail + Instagram channels via Nango OAuth vault (channels disabled when unset).
# Nango dashboard must define provider config keys: "google-mail" and "instagram".
NANGO_SECRET_KEY=
NEXT_PUBLIC_NANGO_PUBLIC_KEY=

# Meta channels (Instagram/WhatsApp/Facebook) — inbound webhooks.
# META_APP_SECRET: your Meta app's App Secret (verifies webhook signatures).
# META_WEBHOOK_VERIFY_TOKEN: any string you choose; paste the same value into
# the Meta webhook config's "Verify Token" field.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Cloud API (outbound replies + inbound routing). Unlike Instagram,
# WhatsApp does NOT go through Nango: it uses a long-lived System User token for
# one WhatsApp Business Account. A temporary Graph API Explorer token expires in
# ~60 days and WhatsApp then goes quiet with no obvious cause — use a System User.
# WHATSAPP_PHONE_NUMBER_ID: the business number's id; inbound webhooks are routed
# on it, and it's the Graph API send endpoint. Map it to a workspace with
#   pnpm tsx scripts/whatsapp-setup.ts --workspace <uuid>
# WHATSAPP_BUSINESS_ACCOUNT_ID: WABA id — display/diagnostics only today.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Paddle Billing — the payment provider (Stripe is unavailable in Lebanon).
# Paddle is MERCHANT OF RECORD: it sells to the customer and handles tax, so
# the terms/refund pages must name the selling entity, not us.
#
# The offer is ONE checkout with TWO items: the setup price (one-time, covers
# month one) plus the recurring price. The recurring price MUST have a 30-day
# trial configured ON THE PRICE in Paddle — Paddle cannot create a subscription
# via API and trial length lives on the price. Without it the customer is
# charged setup + monthly on day one.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Recurring price ids — one per payable plan. The WORKER needs all four of
# these (packages/core/src/paddleSync.ts resolves a subscription's price back to
# a plan); an unset one makes billing.reconcile skip that subscription with
# "unrecognised price" and silently drop it out of drift repair.
PADDLE_PRICE_ENTRY=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_PRO=
# One-time setup price. Entry is the only plan that charges one, so this is the
# only *_SETUP variable. Web app only — the worker never resolves setup prices.
PADDLE_PRICE_ENTRY_SETUP=

# Billing (Step 9) — optional: without it, workspaces stay on trial credits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_SETUP=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_SETUP=
# Canonical public URL — drives OG tags, sitemap, robots, and links in emails.
# Local default below. In production set this in Vercel to your canonical host:
#   NEXT_PUBLIC_APP_URL=https://www.ovanth.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public support/contact email shown in the app (help page, billing, legal pages).
# Optional — lib/legal.ts already defaults to the real address. Set this only to
# override for a staging environment.
NEXT_PUBLIC_SUPPORT_EMAIL=support@ovanth.com

# Legal/company details rendered in the Privacy/Terms/Refund pages.
#
# These are NO LONGER REQUIRED: the real entity, address, registration number,
# contact and jurisdiction are the defaults in apps/web/lib/legal.ts. They used
# to be env-only with placeholder fallbacks, nobody set them, and production
# served a policy naming Delaware. Overrides kept for staging only.
NEXT_PUBLIC_LEGAL_ENTITY="Abdel Khalek Trading Establishment for Tires"
NEXT_PUBLIC_PRIVACY_EMAIL=support@ovanth.com
NEXT_PUBLIC_GOVERNING_LAW="Lebanon"
NEXT_PUBLIC_LEGAL_UPDATED=2026-08-21

# ── Account activation & admin ──────────────────────────────────────────────
# New signups land inactive (users.is_active = false) and see the /pending
# holding page until an admin activates them at /admin.
# ADMIN_USER_ID: the Clerk user id (user_xxx) allowed into /admin. Unset = no
# admin access at all (fails closed). Find it in Clerk Dashboard → Users.
ADMIN_USER_ID=

# Paid billing master switch. While this is not "true", all Stripe code stays in
# place but is inert: no trial expiry, no credit blocking, no checkout offered.
# Set to true once a registered company + LIVE Stripe keys are in place.
BILLING_ENABLED=false

# ── Manual payments (bank transfer / Whish) ────────────────────────────────
# Shown on /checkout so a customer can pay without Stripe. Amounts are always
# quoted as "fresh USD". Leave blank to show a "contact us" message instead.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_IBAN=
WHISH_NUMBER=
# Shown above the payment details so customers can arrange payment with a human.
WHATSAPP_NUMBER=
# Where "payment claimed" alerts are sent (needs RESEND_API_KEY to actually send).
NOTIFICATIONS_TO_ADMIN=
