# Database (Neon in prod; docker-compose locally)
DATABASE_URL=postgres://platform:platform@localhost:5432/platform

# Test database — REQUIRED to run integration tests. Integration tests read ONLY
# this variable; the production DATABASE_URL is ignored under test. If unset,
# integration tests skip (safe). The value must be a local Postgres or a DB whose
# name contains "test" and must NOT equal DATABASE_URL, or the run aborts.
# e.g. TEST_DATABASE_URL=postgres://platform:platform@localhost:5432/platform_test
TEST_DATABASE_URL=

# Redis (BullMQ + engine queue)
REDIS_URL=redis://localhost:6379

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Internal admin (Decision 011): comma-separated founder emails
FOUNDER_EMAILS=

# AI gateway
ANTHROPIC_API_KEY=
# Optional: embeddings for knowledge retrieval (skipped gracefully if unset)
VOYAGE_API_KEY=

# Observability (optional — no-op when unset)
SENTRY_DSN=

# Owner email notifications (Priority 2) — "a reply needs your approval".
# Uses Resend (https://resend.com). Both must be set or emails are skipped
# (drafts still wait in the dashboard). FROM must be a verified sender/domain.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL="Ovanth <notifications@yourdomain.com>"

# Gmail + Instagram channels via Nango OAuth vault (channels disabled when unset).
# Nango dashboard must define provider config keys: "google-mail" and "instagram".
NANGO_SECRET_KEY=
NEXT_PUBLIC_NANGO_PUBLIC_KEY=

# Meta channels (Instagram/WhatsApp/Facebook) — inbound webhooks.
# META_APP_SECRET: your Meta app's App Secret (verifies webhook signatures).
# META_WEBHOOK_VERIFY_TOKEN: any string you choose; paste the same value into
# the Meta webhook config's "Verify Token" field.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Billing (Step 9) — optional: without it, workspaces stay on trial credits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_SETUP=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_SETUP=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public support/contact email shown in the app (billing upgrade link, etc.)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@ovanth.ai

# Legal/company details rendered in the Privacy/Terms/Refund pages. Set these in
# production so policies name your real entity, contact, and jurisdiction.
NEXT_PUBLIC_LEGAL_ENTITY="Ovanth, Inc."
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@ovanth.ai
NEXT_PUBLIC_GOVERNING_LAW="the State of Delaware, USA"
NEXT_PUBLIC_LEGAL_UPDATED=2026-07-23
